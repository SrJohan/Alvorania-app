# Copia a .env.local y rellena con TUS claves (modo test primero). Nunca subas .env.local a git.

# demo = datos falsos en el navegador (sin claves). live = Supabase + Stripe + Resend reales.
NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (proyecto en la región UE). Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe en modo TEST. OPCIONAL por ahora: sin estas claves puedes entrar, calcular y subir documentos, pero no contratar un plan.
# Dashboard > Developers > API keys. El secreto del webhook sale de `stripe listen`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_LIVE=
STRIPE_PRICE_FULL=

# Resend con tu dominio verificado (SPF, DKIM, DMARC).
RESEND_API_KEY=
EMAIL_FROM="Alvorania <avisos@tu-dominio.es>"

# Secreto para las rutas /api/jobs/* (Vercel Cron lo envía como Bearer). Genera uno largo y aleatorio.
CRON_SECRET=

# true en producción: el cálculo se niega a usar reglas fiscales que un fiscalista no ha revisado.
REQUIRE_REVIEWED_TAX_RULES=false

# Web pública (WordPress): destino de «Ver la web» y de las salidas de sesión.
NEXT_PUBLIC_WEB_URL=https://alvorania.es
